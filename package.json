{
  "name": "openchamber-visual-markdown",
  "version": "0.1.0",
  "description": "Read and edit Markdown as a document in OpenChamber. The file stays plain Markdown.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.0" },
    "id": "visual-markdown",
    "name": "Visual Markdown",
    "icon": "icon.svg",
    "contributes": {
      "fileEditors": [
        {
          "id": "visual-markdown",
          "title": "Visual Markdown",
          "match": ["*.md", "*.markdown"],
          "entry": "editor/index.html"
        }
      ],
      "capabilities": ["files"]
    }
  },
  "scripts": {
    "upstream": "node scripts/fetch-upstream.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/unit",
    "test:harness": "node test/harness/run.mjs",
    "check": "bunx openchamber-guest-check"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.0"
  }
}
