+/**
+ * Added by Visual Markdown: each top-level block's Markdown exactly as the next sync writes
+ * it, with the block's index in the document. Blank-line paragraphs are left out.
+ *
+ * @param editor - Editor loaded with {@link setMarkdownContentPreservingSource}
+ * @returns null when the editor has no Markdown serializer
+ */
+export function listSyncBlocks(editor: Editor): { index: number; markdown: string }[] | null {
+  const manager = getMarkdownManager(editor);
+  const documentNode = getEditorDocument(editor);
+  if (!manager?.serialize || documentNode === null) return null;
+  patchMarkdownSerialization(manager);
+
+  const serialize = manager.serialize.bind(manager);
+  const cache = getEditorBlockCache(editor, manager.serialize);
+  const blocks: { index: number; markdown: string }[] = [];
+  for (let index = 0; index < documentNode.childCount; index++) {
+    const node = documentNode.child(index);
+    const cached = cache.blocks.get(node);
+    const remembered = cache.sources[index];
+    const markdown =
+      cached !== undefined
+        ? cached.markdown
+        : remembered !== undefined && remembered.node.eq?.(node)
+          ? remembered.block.markdown
+          : serializeBlockMarkdown(node.toJSON(), serialize);
+    if (markdown !== '') blocks.push({ index, markdown });
+  }
+  return blocks;
+}
