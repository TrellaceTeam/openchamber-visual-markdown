+/**
+ * What the page hosting the editor needs to keep the file's own Markdown style.
+ *
+ * Added by Visual Markdown (https://github.com/TrellaceTeam/openchamber-visual-markdown).
+ *
+ * The editor saves an unedited block exactly as it was written. Once a block is edited,
+ * the serializer rewrites the whole block in its own style: `*` bullets become `-`, a
+ * hand-wrapped paragraph gets a hard break on every line, a padded table is repadded.
+ *
+ * A host can undo that with a three-way merge: the block as authored, the block as the
+ * serializer writes it, and the edited block. This file gives the host the first two for
+ * every block, the blocks as they stand now, and a way to check that a merged text still
+ * loads as the blocks on screen.
+ */
+
+import type { Editor, JSONContent } from '@tiptap/core';
+import type { Node as ProseMirrorNode } from '@tiptap/pm/model';
+import {
+  listRememberedBlockSources,
+  listSyncBlocks,
+  patchMarkdownSerialization,
+  serializeBlockMarkdown,
+  stripEmptyDocParagraphsFromJson,
+} from './markdownSerialization';
+
+/** One top-level block of the loaded document. Empty paragraphs are left out. */
+export interface HostBridgeBlock {
+  /** The block's Markdown as authored, or null when the editor does not hold it. */
+  readonly source: string | null;
+  /** What the serializer writes for the block once it is edited. */
+  readonly serialized: string;
+}
+
+export interface HostBridge {
+  /** Call right after a document loads, before any edit. */
+  describeBlocks: () => HostBridgeBlock[] | null;
+  /**
+   * The Markdown of each block now, exactly as the next sync writes it. The positions in
+   * this list are the block numbers {@link HostBridge.matchesBlocks} takes.
+   */
+  currentBlocks: () => string[] | null;
+  /**
+   * Whether `markdown` loads as blocks `from` up to `to` of the last {@link
+   * HostBridge.currentBlocks} list, or failing that, as `alternative` loads. False when the
+   * document changed since that list was made.
+   *
+   * `alternative` is the editor's own text for the same blocks. A text that loads the same
+   * as it is no worse than what the editor would have saved. `markdown` must load as exactly
+   * as many blocks as `alternative` does, and anything either holds after the blocks, such as
+   * link definitions, must load the same in both. So a text that carries one block twice,
+   * or a block the person deleted, is refused.
+   */
+  matchesBlocks: (from: number, to: number, markdown: string, alternative: string) => boolean;
+  /**
+   * Whether `markdown` loads as the whole document on screen now or, failing that, as
+   * `alternative`, the editor's own text for the document, loads.
+   */
+  matchesDocument: (markdown: string, alternative?: string) => boolean;
+}
+
+type Manager = {
+  serialize?: (json: JSONContent) => string;
+  parse?: (markdown: string) => JSONContent;
+};
+
+function managerOf(editor: Editor): Manager | undefined {
+  const holder = editor as unknown as { markdown?: Manager; storage?: { markdown?: Manager } };
+  return holder.markdown ?? holder.storage?.markdown;
+}
+
+function describeBlocks(editor: Editor): HostBridgeBlock[] | null {
+  const manager = managerOf(editor);
+  if (!manager?.serialize) return null;
+  patchMarkdownSerialization(manager as never);
+  const serialize = manager.serialize.bind(manager);
+
+  const remembered = new Map(listRememberedBlockSources(editor).map(block => [block.index, block]));
+  const blocks: HostBridgeBlock[] = [];
+  const doc = editor.state.doc;
+  for (let index = 0; index < doc.childCount; index++) {
+    const held = remembered.get(index);
+    if (held) {
+      blocks.push({ source: held.source, serialized: held.serialized });
+      continue;
+    }
+    const serialized = serializeBlockMarkdown(doc.child(index).toJSON() as JSONContent, serialize);
+    // An empty paragraph stands for a blank line. It is layout, not a block.
+    if (serialized !== '') blocks.push({ source: null, serialized });
+  }
+  return blocks;
+}
+
+/** The blocks a Markdown text loads as, without the paragraphs that stand for blank lines. */
+function parseBlocks(editor: Editor, markdown: string): JSONContent[] | null {
+  const manager = managerOf(editor);
+  if (typeof manager?.parse !== 'function') return null;
+  return stripEmptyDocParagraphsFromJson(manager.parse(markdown)).content ?? [];
+}
+
+/** Publish the bridge on `window.visualMarkdownEditor`. */
+export function installHostBridge(getEditor: () => Editor | null): void {
+  // The document `currentBlocks` last listed, and where each listed block sits in it.
+  let listed: { doc: ProseMirrorNode; indexes: number[] } | null = null;
+
+  const bridge: HostBridge = {
+    describeBlocks: () => {
+      const editor = getEditor();
+      return editor ? describeBlocks(editor) : null;
+    },
+    currentBlocks: () => {
+      const editor = getEditor();
+      const blocks = editor ? listSyncBlocks(editor) : null;
+      if (!editor || !blocks) {
+        listed = null;
+        return null;
+      }
+      listed = { doc: editor.state.doc, indexes: blocks.map(block => block.index) };
+      return blocks.map(block => block.markdown);
+    },
+    matchesBlocks: (from, to, markdown, alternative) => {
+      const editor = getEditor();
+      if (!editor || !listed || listed.doc !== editor.state.doc) return false;
+      const count = to - from;
+      if (!(from >= 0 && count > 0 && to <= listed.indexes.length)) return false;
+      try {
+        const parsed = parseBlocks(editor, markdown);
+        const other = parseBlocks(editor, alternative);
+        if (!parsed || !other) return false;
+        // No more blocks and no fewer than the editor's own text for the same stretch.
+        if (parsed.length !== other.length || parsed.length < count) return false;
+        const nodes = parsed.map(json => editor.schema.nodeFromJSON(json));
+        const others = other.map(json => editor.schema.nodeFromJSON(json));
+        for (let index = count; index < nodes.length; index++) {
+          if (!nodes[index].eq(others[index])) return false;
+        }
+        const live = listed;
+        const head = nodes.slice(0, count);
+        return (
+          head.every((node, offset) => node.eq(live.doc.child(live.indexes[from + offset]))) ||
+          head.every((node, offset) => node.eq(others[offset]))
+        );
+      } catch {
+        return false;
+      }
+    },
+    matchesDocument: (markdown, alternative) => {
+      const editor = getEditor();
+      if (!editor) return false;
+      try {
+        const parsed = parseBlocks(editor, markdown);
+        if (!parsed) return false;
+        const sameAs = (blocks: JSONContent[]): boolean =>
+          parsed.length === blocks.length &&
+          parsed.every((json, index) =>
+            editor.schema.nodeFromJSON(json).eq(editor.schema.nodeFromJSON(blocks[index]))
+          );
+        const wanted = (editor.state.doc.toJSON() as JSONContent).content ?? [];
+        const live = stripEmptyDocParagraphsFromJson({ type: 'doc', content: wanted }).content ?? [];
+        if (sameAs(live)) return true;
+        if (alternative === undefined) return false;
+        // The editor's own text does not always load back as what is on screen. A text that
+        // loads the same as it is no worse than what the editor would have saved.
+        const other = parseBlocks(editor, alternative);
+        return other !== null && sameAs(other);
+      } catch {
+        return false;
+      }
+    },
+  };
+  (window as unknown as { visualMarkdownEditor?: HostBridge }).visualMarkdownEditor = bridge;
+}
