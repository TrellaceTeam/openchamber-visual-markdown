@@ -0,0 +1,50 @@
+/**
+ * Let the page that hosts the editor choose Mermaid's colours.
+ *
+ * Added by Visual Markdown (https://github.com/TrellaceTeam/openchamber-visual-markdown).
+ *
+ * Mermaid bakes its theme into each SVG. The editor picks Mermaid's stock `default` or
+ * `dark` theme from the background colour. A host with its own palette can set
+ * `window.visualMarkdownMermaidTheme` to return Mermaid theme settings instead, so
+ * diagrams match the rest of the page. Without that function nothing changes.
+ */
+
+export interface HostMermaidTheme {
+  /** A Mermaid theme name, usually `base` when `themeVariables` are given. */
+  readonly theme: string;
+  readonly themeVariables?: Readonly<Record<string, string | boolean>>;
+  /** Changes whenever the colours do, so mounted diagrams are drawn again. */
+  readonly key?: string;
+}
+
+type Provider = (dark: boolean) => HostMermaidTheme | null | undefined;
+
+function supplied(dark: boolean): HostMermaidTheme | null {
+  const provider = (window as unknown as { visualMarkdownMermaidTheme?: Provider })
+    .visualMarkdownMermaidTheme;
+  if (typeof provider !== 'function') return null;
+  try {
+    const theme = provider(dark);
+    return theme && typeof theme.theme === 'string' ? theme : null;
+  } catch (error) {
+    console.warn('[MD4H] Host Mermaid theme failed:', error);
+    return null;
+  }
+}
+
+/** The `theme` and `themeVariables` to pass to `mermaid.initialize`. */
+export function mermaidThemeConfig(dark: boolean): {
+  theme: string;
+  themeVariables?: Record<string, string | boolean>;
+} {
+  const host = supplied(dark);
+  if (!host) return { theme: dark ? 'dark' : 'default' };
+  return host.themeVariables
+    ? { theme: host.theme, themeVariables: { ...host.themeVariables } }
+    : { theme: host.theme };
+}
+
+/** A string that differs whenever a re-render would look different. */
+export function mermaidThemeKey(dark: boolean): string {
+  return `${dark ? 'dark' : 'light'}:${supplied(dark)?.key ?? ''}`;
+}
